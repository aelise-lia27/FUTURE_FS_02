# Server
PORT=5000
NODE_ENV=development

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prestance_x_crm

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_key
JWT_EXPIRES_IN=1d

# Seed Admin Account
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_EMAIL=admin@prestancex.com
SEED_ADMIN_PASSWORD=Admin@12345

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173
